# 🌐 本文档由 github/gitignore (https://github.com/github/gitignore) 翻译,英文原版见原项目。

# 前置依赖文件
*.d

# 编译产生的目标文件
*.slo
*.lo
*.o
*.obj

# 预编译头
*.gch
*.pch

# 链接器文件
*.ilk

# 调试器文件
*.pdb

# 编译产生的动态库
*.so
*.dylib
*.dll
*.so.*

# Fortran 模块文件
*.mod
*.smod

# 编译产生的静态库
*.lai
*.la
*.a
*.lib

# 可执行文件
*.exe
*.out
*.app

# 构建目录
build/
Build/
build-*/

# CMake 生成文件
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# 临时文件
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# 调试信息文件
*.dwo

# 测试输出与缓存
Testing/
.cache/
