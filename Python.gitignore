*.sage.py

# 虚拟环境
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder 项目设置
.spyderproject
.spyproject

# Rope 项目设置
.ropeproject

# mkdocs 文档
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre 类型检查器
.pyre/

# pytype 静态类型分析器
.pytype/

# Cython 调试符号
cython_debug/

# PyCharm
#   JetBrains 专属模板单独维护在 JetBrains.gitignore 中,地址:
#   https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#   可加入全局 gitignore 或合并进本文件。若想用更彻底(不推荐)的方案,
#   可取消下一行注释,忽略整个 idea 目录。
# .idea/

# Abstra
#   Abstra 是一个 AI 驱动的流程自动化框架。
#   忽略包含用户凭证、本地状态和设置的目录。
#   更多信息见 https://abstra.io/docs
.abstra/

# Visual Studio Code
#   VS Code 专属模板单独维护在 VisualStudioCode.gitignore 中,地址:
#   https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#   可加入全局 gitignore 或合并进本文件。当然,如果你愿意,也可以
#   取消下一行注释,忽略整个 vscode 目录
# .vscode/
# 局部执行代码产生的临时文件
tempCodeRunnerFile.py

# Ruff 相关:
.ruff_cache/

# PyPI 配置文件
.pypirc

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit
.streamlit/secrets.toml
