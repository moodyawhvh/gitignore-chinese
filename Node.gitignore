# 🌐 本文档由 github/gitignore (https://github.com/github/gitignore) 翻译,英文原版见原项目。

# 日志
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# 诊断报告 (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# 运行时数据
pids
*.pid
*.seed
*.pid.lock

# jscoverage/JSCover 生成的插桩库目录
lib-cov

# istanbul 等工具使用的覆盖率目录
coverage
*.lcov

# nyc 测试覆盖率
.nyc_output

# Grunt 中间存储 (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower 依赖目录 (https://bower.io/)
bower_components

# node-waf 配置
.lock-wscript

# 编译出的二进制插件 (https://nodejs.org/api/addons.html)
build/Release

# 依赖目录
node_modules/
jspm_packages/

# Snowpack 依赖目录 (https://snowpack.dev/)
web_modules/

# TypeScript 缓存
*.tsbuildinfo

# 可选的 npm 缓存目录
.npm

# 可选的 eslint 缓存
.eslintcache

# 可选的 stylelint 缓存
.stylelintcache

# 可选的 REPL 历史记录
.node_repl_history

# 'npm pack' 的输出
*.tgz

# Yarn 完整性校验文件
.yarn-integrity

# dotenv 环境变量文件
.env
.env.*
!.env.example

# parcel-bundler 缓存 (https://parceljs.org/)
.cache
.parcel-cache

# Next.js 构建输出
.next
out

# Nuxt.js 构建 / 生成输出
.nuxt
dist
.output

# Gatsby 文件
.cache/
# 如果你的项目用的是 Gatsby 而不是 Next.js,请取消下一行 public 的注释
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress 构建输出
.vuepress/dist

# vuepress v2.x 临时目录
.temp

# Sveltekit 缓存目录
.svelte-kit/

# vitepress 构建输出
**/.vitepress/dist

# vitepress 缓存目录
**/.vitepress/cache

# Docusaurus 缓存与生成文件
.docusaurus

# Serverless 目录
.serverless/

# FuseBox 缓存
.fusebox/

# DynamoDB Local 文件
.dynamodb/

# Firebase 缓存目录
.firebase/

# TernJS 端口文件
.tern-port

# 存储用于测试 Visual Studio Code 扩展的 VS Code 版本
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite 文件
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/
