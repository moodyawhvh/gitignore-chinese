# 🌐 本文档由 github/gitignore (https://github.com/github/gitignore) 翻译,英文原版见原项目。

# Gradle 文件
.gradle/
build/

# 本地配置文件(sdk 路径等)
local.properties

# 日志 / 系统文件
*.log

# Android Studio 生成的文件与目录
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# 密钥库文件
*.jks
*.keystore

# Google 服务(如 APIs 或 Firebase)
google-services.json

# Android 性能分析
*.hprof
